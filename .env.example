# ── Cadence configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you have.
# Everything works in "preview" mode even without keys; keys enable the
# real research LLM and email delivery.

# ── LLM: Groq (open-weight Llama 3.3 70B) ─────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Any model served by Groq. Default is an open-weights Llama.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Email delivery: Resend ────────────────────────────────────────────
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address. For the free tier you can use onboarding@resend.dev
# until you verify your own domain.
EMAIL_FROM=Cadence <onboarding@resend.dev>

# ── Web search ────────────────────────────────────────────────────────
# DuckDuckGo needs no key and is used automatically.

# ── App ───────────────────────────────────────────────────────────────
# Where the SQLite database lives.
DATABASE_URL=sqlite:///./cadence.db
# Default timezone offered in the UI.
DEFAULT_TIMEZONE=Asia/Kolkata
